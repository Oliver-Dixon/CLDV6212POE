@baseUrl = http://localhost:7071/api

### Create — expect 201
POST {{baseUrl}}/menu
Content-Type: application/json

{
  "category": "Cold Drinks",
  "sku": "COL-001",
  "name": "Iced Latte",
  "description": "Double shot over ice",
  "price": 38.00,
  "isAvailable": true
}

### Invalid SKU — expect 400
POST {{baseUrl}}/menu
Content-Type: application/json

{
  "category": "Cold Drinks",
  "sku": "bad-sku",
  "name": "Test Item",
  "price": 10.00
}

### Duplicate — expect 409
POST {{baseUrl}}/menu
Content-Type: application/json

{
  "category": "Cold Drinks",
  "sku": "COL-001",
  "name": "Iced Latte",
  "price": 38.00
}

### Update — expect 200
PUT {{baseUrl}}/menu/Cold Drinks/COL-001
Content-Type: application/json

{
  "price": 42.00,
  "isAvailable": false
}

### Update missing — expect 404
PUT {{baseUrl}}/menu/Cold Drinks/XXX-999
Content-Type: application/json

{
  "price": 10.00
}

### Delete — expect 200
DELETE {{baseUrl}}/menu/Cold Drinks/COL-001

### Delete again — expect 404
DELETE {{baseUrl}}/menu/Cold Drinks/COL-001