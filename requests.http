@baseUrl = http://localhost:7071/api

### Create — should return 201
POST {{baseUrl}}/menu
Content-Type: application/json

{
  "category": "Cold Drinks",
  "sku": "COL-001",
  "name": "Iced Latte",
  "description": "Double shot over ice",
  "price": 38.00,
  "isAvailable": true
}

### Duplicate — should return 409
POST {{baseUrl}}/menu
Content-Type: application/json

{
  "category": "Cold Drinks",
  "sku": "COL-001",
  "name": "Iced Latte",
  "price": 38.00
}

### Invalid SKU — should return 400
POST {{baseUrl}}/menu
Content-Type: application/json

{
  "category": "Cold Drinks",
  "sku": "bad-sku",
  "name": "Test",
  "price": 10.00
}

### Update price — should return 200
PUT {{baseUrl}}/menu/Cold Drinks/COL-001
Content-Type: application/json

{
  "price": 42.00,
  "isAvailable": false
}

### Update nonexistent — should return 404
PUT {{baseUrl}}/menu/Cold Drinks/XXX-999
Content-Type: application/json

{
  "price": 10.00
}

### Delete — should return 200
DELETE {{baseUrl}}/menu/Cold Drinks/COL-001

### Delete again — should return 404
DELETE {{baseUrl}}/menu/Cold Drinks/COL-001