            "body": {
              "mode": "raw",
              "raw": "{\n    \"category\": \"Cold Drinks\",\n    \"sku\": \"COL-099\",\n    \"description\": \"No name supplied\",\n    \"price\": 25.00,\n    \"isAvailable\": true\n}",
              "options": {
                "raw": {
