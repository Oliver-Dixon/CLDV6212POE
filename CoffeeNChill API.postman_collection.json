                  "pm.test(\"Returns an array of entities\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"array\");",
                  "    pm.expect(body.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Entities carry the expected shape\", function () {",
                  "    const first = pm.response.json()[0];",
                  "    pm.expect(first).to.have.property(\"partitionKey\");",
                  "    pm.expect(first).to.have.property(\"rowKey\");",
                  "    pm.expect(first).to.have.property(\"name\");",
                  "    pm.expect(first).to.have.property(\"price\");",
                  "    pm.expect(first).to.have.property(\"isAvailable\");",
                  "});"
                ]
              }
            }
          ],
