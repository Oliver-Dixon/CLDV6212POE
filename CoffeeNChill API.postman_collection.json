        {
          "name": "Get Menu Items By Category (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Every item belongs to the requested partition\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"array\").that.is.not.empty;",
                  "    body.forEach(function (item) {",
                  "        pm.expect(item.partitionKey).to.eql(\"Hot Drinks\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Other categories are excluded\", function () {",
                  "    const names = pm.response.json().map(function (i) { return i.partitionKey; });",
                  "    pm.expect(names).to.not.include(\"Pastries\");",
                  "});"
                ]
              }
            }
