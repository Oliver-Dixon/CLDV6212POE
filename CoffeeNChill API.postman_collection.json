    {
      "name": "02 - Staff Documents",
      "item": [
        {
          "name": "Upload Document (valid PDF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Metadata is returned\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"fileName\");",
                  "    pm.expect(body).to.have.property(\"sizeBytes\");",
                  "    pm.expect(body).to.have.property(\"lastModified\");",
                  "    pm.expect(body.contentType).to.eql(\"application/pdf\");",
                  "});",
                  "",
                  "pm.test(\"Reported size is greater than zero\", function () {",
                  "    pm.expect(pm.response.json().sizeBytes).to.be.above(0);",
                  "});",
                  "",
                  "const uploaded = pm.response.json();",
                  "pm.environment.set(\"fileName\", uploaded.fileName);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/C:/dev/CLDV6212POE/staff-documents.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "upload"
