        {
          "name": "Update Menu Item (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Price was updated\", function () {",
                  "    pm.expect(pm.response.json().price).to.eql(42);",
                  "});",
                  "",
                  "pm.test(\"Availability was updated\", function () {",
                  "    pm.expect(pm.response.json().isAvailable).to.eql(false);",
                  "});",
                  "",
                  "pm.test(\"Untouched fields are preserved\", function () {",
                  "    pm.expect(pm.response.json().name).to.eql(\"Iced Latte\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"price\": 42.00,\n    \"isAvailable\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/menu/{{category}}/{{sku}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
