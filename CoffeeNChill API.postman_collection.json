            "body": {
              "mode": "raw",
              "raw": "{\n    \"category\": \"Cold Drinks\",\n    \"sku\": \"COL-001\",\n    \"name\": \"Iced Latte\",\n    \"description\": \"Same PartitionKey and RowKey as the item created above\",\n    \"price\": 38.00,\n    \"isAvailable\": true\n}",
              "options": {
                "raw": {
