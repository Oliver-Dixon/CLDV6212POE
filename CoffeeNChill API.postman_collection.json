    {
      "name": "01 - Menu Management",
      "item": [
        {
          "name": "Create Menu Item (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Returns the created entity\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"partitionKey\");",
                  "    pm.expect(body).to.have.property(\"rowKey\");",
                  "    pm.expect(body.name).to.eql(\"Iced Latte\");",
                  "    pm.expect(body.price).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Location header points at the new resource\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"COL-001\");",
                  "});",
                  "",
                  "pm.test(\"Responds in under 2 seconds\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "// Chain the identifiers into the requests that follow",
                  "const created = pm.response.json();",
                  "pm.environment.set(\"category\", created.partitionKey);",
                  "pm.environment.set(\"sku\", created.rowKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"category\": \"Cold Drinks\",\n    \"sku\": \"COL-001\",\n    \"name\": \"Iced Latte\",\n    \"description\": \"Double shot over ice with cold milk\",\n    \"price\": 38.00,\n    \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            },
            "description": "Inserts a new entity into the MenuItems table. Category becomes the PartitionKey, SKU becomes the RowKey."
          },
          "response": []
        },
        {
          "name": "Create Menu Item (invalid SKU) - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Returns structured validation errors\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"error\");",
                  "    pm.expect(body.details).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Error names the SKU rule\", function () {",
                  "    const body = pm.response.json();",
                  "    const joined = body.details.join(\" \");",
                  "    pm.expect(joined.toLowerCase()).to.include(\"sku\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"category\": \"Cold Drinks\",\n    \"sku\": \"bad-sku\",\n    \"name\": \"Malformed SKU Test\",\n    \"description\": \"SKU does not match the AAA-000 pattern\",\n    \"price\": 25.00,\n    \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            },
            "description": "SKU must be three capitals, a hyphen, then three digits. This payload should be rejected by the data annotation validator."
          },
          "response": []
        },
